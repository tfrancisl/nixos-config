// https://niri-wm.github.io/niri/Configuration:-Introduction
// nix.kdl is generated by default.nix (binds that need program paths)

include "nix.kdl"

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 300
        repeat-rate 99
    }
    focus-follows-mouse
}

output "DP-3" {
    mode "3440x1440@180"
    position x=1920 y=0
    scale 1
    focus-at-startup
}

output "DP-1" {
    mode "1920x1080@60"
    position x=0 y=0
    scale 1
}

cursor {
    xcursor-theme "graphite-light"
    xcursor-size 32
}

clipboard {
    disable-primary
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

layout {
    gaps 4

    focus-ring {
        off
    }

    border {
        width 4
        active-gradient from="#41d8d5" to="#15f88d" angle=45
        inactive-color "#680726"
    }

    shadow {
        off
    }
}

animations {
    window-open {
        duration-ms 300
        curve "cubic-bezier" 0.25 0.65 0.0 1.0
    }
    window-close {
        duration-ms 400
        curve "cubic-bezier" 0.25 0.65 0.0 1.0
    }
    window-movement {
        duration-ms 400
        curve "cubic-bezier" 0.25 0.65 0.0 1.0
    }
    window-resize {
        duration-ms 400
        curve "cubic-bezier" 0.25 0.65 0.0 1.0
    }
    horizontal-view-movement {
        duration-ms 400
        curve "cubic-bezier" 0.25 0.65 0.0 1.0
    }
}

window-rule {
    geometry-corner-radius 5
    clip-to-geometry true
}

window-rule {
    match is-active=false
    opacity 0.935
}

// sized and placed for the 3440x1440 output
window-rule {
    match app-id="^Alacritty$"
    open-floating true
    default-column-width { fixed 1280; }
    default-window-height { fixed 720; }
    default-floating-position x=688 y=288 relative-to="top-left"
}

window-rule {
    match app-id="^Alacritty$" is-active=false
    opacity 0.34
}

window-rule {
    match is-floating=true is-active=false
    border {
        inactive-color "#111212"
    }
}

window-rule {
    match is-floating=true is-active=true
    border {
        active-color "#4122d5"
    }
}

binds {
    Mod+C { close-window; }
    Mod+M { quit skip-confirmation=true; }
    Mod+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }

    Mod+Left  { focus-column-or-monitor-left; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Down  { focus-window-or-workspace-down; }
}
